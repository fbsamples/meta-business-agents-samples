# System user access token with whatsapp_business_messaging and whatsapp_business_management.
# Business Settings > Users > System users > Generate new token.
MBA_TOKEN=
# WhatsApp Business phone number ID (not the WABA ID): WhatsApp Manager > Account tools > Phone numbers.
MBA_ENTITY_ID=
# Secrets referenced from agent.yaml as ${NAME}. Only keys listed in this file can be referenced.
# With the mock backend, start it with MOCK_API_KEY set to this same value.
ORDERS_API_KEY=
